############################################
# Enhanced Ground Targeting configuration
############################################
#
#    EnhancedGroundTargeting.Enable
#        Description: Enable the enhanced ground targeting module.
#                    Characters remain opted out until they use .toggle on.
#        Default:     1 - Enabled
#                     0 - Disabled
#

EnhancedGroundTargeting.Enable = 1

#
#    EnhancedGroundTargeting.AutoTarget
#        Description: Replace supported spells' cursor destinations automatically.
#        Default:     1 - Enabled
#                     0 - Disabled
#

EnhancedGroundTargeting.AutoTarget = 1

#
#    EnhancedGroundTargeting.CombatOnly
#        Description: Only include the selected enemy or enemies engaged with the player's party or their pets.
#        Default:     1 - Enabled
#                     0 - Disabled
#

EnhancedGroundTargeting.CombatOnly = 1

#
#    EnhancedGroundTargeting.SmartPositioning
#        Description: Enable smart AOE positioning.
#                    When enabled, the system will calculate optimal positions
#                    to hit maximum enemies instead of just targeting current target.
#                    Combat safety is controlled by EnhancedGroundTargeting.CombatOnly.
#        Default:     1 - Enabled (smart positioning)
#                     0 - Disabled (simple target positioning)
#

EnhancedGroundTargeting.SmartPositioning = 1

#
#    EnhancedGroundTargeting.MinEnemiesForSmart
#        Description: Minimum number of enemies required to use smart positioning.
#                    If fewer enemies would be covered, falls back to target positioning.
#        Default:     2 - Require at least 2 enemies for smart positioning
#

EnhancedGroundTargeting.MinEnemiesForSmart = 2
